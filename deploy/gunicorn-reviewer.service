# systemd USER service that keeps the AI Image Reviewer running permanently
# on your VPS (DigitalOcean Droplet, DreamHost VPS, etc.), restarting it
# automatically if it crashes or the server reboots.
#
# Install as: ~/.config/systemd/user/gunicorn-reviewer.service
# Then run:
#   systemctl --user daemon-reload
#   systemctl --user enable --now gunicorn-reviewer
#   loginctl enable-linger $USER   # lets it keep running after you log out
#
# Replace REPLACE_WITH_APP_DIR below with the folder you deployed into,
# e.g. /home/yourusername/ai-image-reviewer

[Unit]
Description=AI Image Reviewer (FastAPI via Gunicorn/Uvicorn workers)
After=network.target

[Service]
WorkingDirectory=REPLACE_WITH_APP_DIR
EnvironmentFile=REPLACE_WITH_APP_DIR/.env
ExecStart=REPLACE_WITH_APP_DIR/venv/bin/gunicorn server:app -k uvicorn.workers.UvicornWorker -w 2 -b 127.0.0.1:8000 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
