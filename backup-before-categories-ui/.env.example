# Copy this file to .env and fill in your real key:
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=your-api-key-here

# Optional: override the model used for reviews
CLAUDE_MODEL=claude-sonnet-5

# Optional: how thoroughly Claude reasons before answering.
# Recent models (including claude-sonnet-5) don't support temperature/top_p/
# top_k, so this is the main lever for consistent, careful judgments --
# especially for detail-sensitive criteria like spotting misspellings.
# Options: max, xhigh, high, medium, low. Higher = more consistent and
# accurate, but more tokens/latency/cost. Default: high.
# If you raise this to xhigh or max, also raise CLAUDE_MAX_TOKENS below --
# otherwise responses can get cut off mid-thought before finishing the JSON.
CLAUDE_EFFORT=high

# Optional: max tokens per review response (Claude's internal reasoning +
# the final JSON answer share this budget). Raise this if you raise
# CLAUDE_EFFORT and start seeing "cut off before finishing" errors.
CLAUDE_MAX_TOKENS=8192

# Optional: override cost estimates shown in the Token Usage widget if you
# change CLAUDE_MODEL or pricing changes. See https://platform.claude.com/docs/en/about-claude/pricing
PRICE_PER_MTOK_INPUT=2.0
PRICE_PER_MTOK_OUTPUT=10.0

# Optional: where the SQLite database and saved review images/logos are
# stored. Defaults to a "data" folder inside this project folder. Only
# override this if you move the project into a OneDrive/Dropbox/Google
# Drive synced folder again -- SQLite and cloud sync don't mix well
# (locking errors, possible corruption), so point this somewhere unsynced
# in that case.
# REVIEWER_DATA_DIR=/path/to/unsynced/folder
